<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>hr.ivona</groupId>
    <artifactId>java26-test-automation</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Shared build properties keep Java and test-library versions in one place. -->
    <properties>
        <!-- Compile project source against the specified Java language and API level. -->
        <maven.compiler.release>26</maven.compiler.release>
        <!-- Use UTF-8 consistently when Maven reads and writes project files. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Selenium drives the Chrome browser used for end-to-end UI checks. -->
        <selenium.version>4.49.0</selenium.version>
        <!-- JUnit Jupiter provides test annotations, assertions, and parameterized tests. -->
        <junit.version>6.0.3</junit.version>
    </properties>

    <!-- Test dependencies provide browser automation and the JUnit test platform. -->
    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Pin build plugins so compilation and JUnit test execution are reproducible. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>